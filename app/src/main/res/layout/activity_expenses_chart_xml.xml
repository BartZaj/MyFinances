<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Ekran ładowania -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="#74C69D" />

    <!-- Przewijany główny widok -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="88dp"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Podsumowanie Wydatków XML"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:textColor="#000000"/>

            <com.example.myfinances.CategoriesChartView
                android:id="@+id/categoriesChartView"
                android:layout_width="match_parent"
                android:layout_height="340dp" />

            <!-- ========================================== -->
            <!-- MIEJSCE NA 3 OSTATNIE TRANSAKCJE (W PRZYSZŁOŚCI) -->
            <!-- ========================================== -->
            <Space
                android:id="@+id/recentTransactionsPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="300dp" />

            <!-- Sekcja limitów kategorii -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Limity kategorii (przesuń w bok)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpCategoryLimits"
                android:layout_width="match_parent"
                android:layout_height="180dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddExpense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Dodaj wydatek"
        app:icon="@android:drawable/ic_input_add"
        app:backgroundTint="#D1E8E2" />

</FrameLayout>