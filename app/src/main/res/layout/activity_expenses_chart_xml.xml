<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Ekran ładowania -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="#74C69D" />

    <!-- Główny widok wykresu -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Podsumowanie Wydatków XML"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:textColor="#000000"/>

        <!-- Nasz nowy, dedykowany widok wykresu z rysowaniem na Canvas -->
        <!-- Wysokość 400dp pozwala swobodnie zmieścić rosnące słupki, ikony i pochyłe napisy -->
        <com.example.myfinances.CategoriesChartView
            android:id="@+id/categoriesChartView"
            android:layout_width="match_parent"
            android:layout_height="340dp" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddExpense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Dodaj wydatek"
        app:icon="@android:drawable/ic_input_add"
        app:backgroundTint="#D1E8E2" />

</FrameLayout>